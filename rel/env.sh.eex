#!/bin/sh
# Distributed Erlang settings for clustering instances (see README, "Cluster").
#
# Node name: <release>@<container IP> unless RELEASE_NODE is set explicitly.
export RELEASE_DISTRIBUTION="${RELEASE_DISTRIBUTION:-name}"
if [ -z "$RELEASE_NODE" ]; then
  export RELEASE_NODE="<%= @release.name %>@$(hostname -i | awk '{print $1}')"
fi

# Fixed distribution port for the server itself so it can be allowed in firewalls
# (EPMD uses 4369). Helper commands (rpc, remote, eval) keep a random port.
case $RELEASE_COMMAND in
  start*|daemon*)
    DIST_PORT="${DIST_PORT:-9100}"
    export ELIXIR_ERL_OPTIONS="${ELIXIR_ERL_OPTIONS:-} -kernel inet_dist_listen_min $DIST_PORT inet_dist_listen_max $DIST_PORT"
    ;;
esac
